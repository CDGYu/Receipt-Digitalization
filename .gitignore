# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Node toolchain (the review UI, P5). `dist/` above already covers
# frontend/dist -- a bare pattern matches at every level -- so only the
# dependency tree needs its own entry, and `npm install` drops tens of
# thousands of files there.
node_modules/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets & local env
.env
.env.*
!.env.example

# Local SQLite databases (the alembic fallback URL is sqlite:///receipts.db,
# and a dev DB holds real receipt data)
*.db
*.sqlite
*.sqlite3

# Generated data & exports (receipts may contain PII)
eval/golden/images/
*.xlsx

# OS / editor
.DS_Store
Thumbs.db

# SDD scratch (subagent-driven-development ledger)
.superpowers/

# local baseline run output
baseline_run.log
smoke_*.log
smoke_*.err
smoke_pid.txt

# Local-only tooling config (Kiro steering/hooks/MCP, GitHub Actions)
.kiro/
.github/workflows/
