# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Node toolchain (the review UI, P5). Every ignore rule in this repo lives in
# this file -- the `npm create vite` scaffold ships its own frontend/.gitignore
# that duplicated `node_modules` and `dist`, which only made `git check-ignore`
# blame the nested copy; it was removed in favour of these entries.
# `dist/` above already covers frontend/dist (a bare pattern matches at every
# level), so only the dependency tree needs its own line -- `npm install` drops
# tens of thousands of files there.
node_modules/
dist-ssr/
*.local

# Local blob storage. `STORAGE_ROOT` defaults to `var/blobs` (config/settings.py,
# and RECEIPT_SYSTEM_SPEC.md documents it), so any code path that saves an image
# with default settings writes REAL RECEIPT IMAGES here. That has been true since
# the storage layer landed and this directory was never ignored -- a `git add -A`
# would have published them. Receipt images stay out of git, same as
# eval/golden/images/.
var/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets & local env
.env
.env.*
!.env.example

# Local SQLite databases (the alembic fallback URL is sqlite:///receipts.db,
# and a dev DB holds real receipt data)
*.db
*.sqlite
*.sqlite3

# Generated data & exports (receipts may contain PII)
eval/golden/images/
*.xlsx

# OS / editor
.DS_Store
Thumbs.db

# SDD scratch (subagent-driven-development ledger)
.superpowers/

# local baseline run output
baseline_run.log
smoke_*.log
smoke_*.err
smoke_pid.txt

# Local-only tooling config (Kiro steering/hooks/MCP, GitHub Actions)
.kiro/
.github/workflows/
