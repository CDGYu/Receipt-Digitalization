{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {},
      "disabled": false,
      "autoApprove": []
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}" },
      "disabled": false,
      "autoApprove": []
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {},
      "disabled": true,
      "autoApprove": []
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp",
      "disabled": true,
      "autoApprove": []
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com",
      "disabled": true,
      "autoApprove": []
    }
  }
}
