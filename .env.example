# Receipt Digitization System -- environment template
#
# Copy to `.env` and edit. `.gitignore` ignores `.env` and `.env.*` and makes a
# single exception for THIS file (`!.env.example`), so the template is tracked
# and your real values never are.
#
# ## Every name below is read by `docker-compose.yml`
#
# Enumerated from that file rather than recalled -- `grep -oE '\$\{[A-Z_]+'
# docker-compose.yml | sort -u` -- because a hand-written list of settings is
# exactly the kind of prose that rots the first time somebody adds one. Twelve
# names, re-derived 2026-08-25. If you add a `${VAR}` to compose, add it here.
#
# Every value shown is the default compose already applies, so a `.env` that is
# empty (or absent) behaves identically to this file. Nothing here needs setting
# to bring the stack up.
#
# `config/settings.py` reads this same file directly and knows many more fields
# than compose interpolates. Those are settable too; they are simply not part of
# the container wiring, so they are not listed here.


# ---------------------------------------------------------------------------
# The vision model
# ---------------------------------------------------------------------------

# `ollama` or `openai_compat`. Ollama is the default and the only one this
# project is set up to run locally.
VLM_PROVIDER=ollama

# **Container-internal address, not the one you use from your shell.** Inside
# the compose network the Ollama service answers on `ollama:11434`. On the host
# it is published on **11435** (verified with `docker compose port ollama 11434`
# -> `0.0.0.0:11435`), deliberately offset so it cannot collide with a
# Windows-native Ollama already holding 11434. If you point a script on your
# machine at this stack, use `http://localhost:11435/v1`.
VLM_BASE_URL=http://ollama:11434/v1

# Ollama ignores the key but the OpenAI-compatible client requires one to be
# present. Any non-empty string works.
VLM_API_KEY=ollama-local-unused

VLM_MODEL_EXTRACT=granite3.2-vision:2b
VLM_MODEL_TRIAGE=granite3.2-vision:2b

# Optional second model tried when the primary does not answer in
# VLM_PRIMARY_TIMEOUT_S. Both empty by default, which disables escalation.
VLM_MODEL_EXTRACT_FALLBACK=
VLM_PRIMARY_TIMEOUT_S=

# **One input, read by both `api` and `worker`.** These two disagreed once --
# the api left it unset and took a 120s default while the worker had 3600 --
# and the result was a receipt killed mid-extract and swept to a terminal
# state. Both services now read this same name so they cannot drift.
#
# Several derived ceilings come off it (job timeout, the unstarted-sweep
# window). Lower it and they all come down together.
VLM_TIMEOUT_S=3600


# ---------------------------------------------------------------------------
# Self-consistency (P7.T1) -- worker only
# ---------------------------------------------------------------------------
#
# These reach the `worker` service and not `api`, because `process_receipt`
# runs in the worker. That asymmetry is deliberate; see the comment in
# docker-compose.yml before copying them across.

# **The expensive one.** Extracts a handwritten or low-legibility receipt
# CONSISTENCY_RUNS times at a non-zero temperature and votes, which is that
# many EXTRA model calls on exactly the receipts that are already slowest.
# ADR-0039 measures one extract on a CPU-only box in minutes. Off by default.
CONSISTENCY_ENABLED=false

# How many independent extractions a consistency pass makes. Three is the
# smallest number that can produce a majority; two can only agree or disagree.
CONSISTENCY_RUNS=3

# A second, larger n for the critical fields, spent ON DEMAND: the pass runs
# CONSISTENCY_RUNS, and only escalates to this when the total, date or merchant
# came back with no majority and was nulled. A receipt whose critical fields
# all resolve still costs CONSISTENCY_RUNS.
#
# 0 disables escalation entirely. Set it to 5 to enable. Any value <=
# CONSISTENCY_RUNS is inert.
CONSISTENCY_CRITICAL_RUNS=0

# **A JSON array. Not a comma-separated list.** This field is a
# `tuple[str, ...]` on a pydantic `BaseSettings`, so the value is parsed as
# JSON. Measured rather than assumed: `totals.total,receipt.date` raises
# `SettingsError: error parsing value for field "consistency_critical_fields"`
# and the service refuses to start. Loud is the right failure, but the syntax
# catches people out.
#
# The default is the §12 triple -- the same three fields `score.confidence`
# penalises for being missing and the eval harness scores as `critical_correct`.
# Paths use `extract.paths` grammar (`totals.total`, `line_items[2].qty`).
CONSISTENCY_CRITICAL_FIELDS=["totals.total","receipt.date","merchant.name"]
