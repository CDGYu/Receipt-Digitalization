# Receipt Digitization System -- environment template
#
# Copy to `.env` and edit. `.gitignore` ignores `.env` and `.env.*` and makes a
# single exception for THIS file (`!.env.example`), so the template is tracked
# and your real values never are.
#
# ## The system runs natively -- no containers
#
# `config/settings.py` reads this file directly (pydantic BaseSettings,
# env_file=".env"). Both entry points read the same file:
#   uvicorn receipts.asgi:app        # the review API
#   python -m receipts.worker        # the queue worker
#
# `receipts.asgi` REFUSES TO BOOT unless DATABASE_URL and REDIS_URL are set (and
# SESSION_SECRET, checked a few frames later) -- see the Infra and Service
# sections below. The model and pipeline knobs further down all have working
# defaults, so a `.env` that sets only the required three brings the API up.
#
# `config/settings.py` knows many more fields than are listed here; see its
# docstring and field comments for the full set.


# ---------------------------------------------------------------------------
# The vision model
# ---------------------------------------------------------------------------

# `ollama` or `openai_compat`. Ollama is the default and the only one this
# project is set up to run locally.
VLM_PROVIDER=ollama

# The Ollama daemon running on this host. Its default address is
# `localhost:11434`; run `ollama serve` (or install it as a service) and
# `ollama pull granite3.2-vision:2b` before the first receipt.
VLM_BASE_URL=http://localhost:11434/v1

# Ollama ignores the key but the OpenAI-compatible client requires one to be
# present. Any non-empty string works.
VLM_API_KEY=ollama-local-unused

VLM_MODEL_EXTRACT=granite3.2-vision:2b
VLM_MODEL_TRIAGE=granite3.2-vision:2b

# Optional second model tried when the primary does not answer in
# VLM_PRIMARY_TIMEOUT_S. Both empty by default, which disables escalation.
VLM_MODEL_EXTRACT_FALLBACK=
VLM_PRIMARY_TIMEOUT_S=

# **One input, read by both the API and the worker.** Keep a single value in
# this file so the two processes cannot disagree -- when they did (the API on a
# 120s default while the worker had 3600), a receipt was killed mid-extract and
# swept to a terminal state.
#
# Several derived ceilings come off it (job timeout, the unstarted-sweep
# window). Lower it and they all come down together.
VLM_TIMEOUT_S=3600


# ---------------------------------------------------------------------------
# Self-consistency (P7.T1) -- worker only
# ---------------------------------------------------------------------------
#
# These matter to the worker and not the API, because `process_receipt` runs in
# the worker. That asymmetry is deliberate; setting them for the API process
# would be values that read as live and decide nothing.

# **The expensive one.** Extracts a handwritten or low-legibility receipt
# CONSISTENCY_RUNS times at a non-zero temperature and votes, which is that
# many EXTRA model calls on exactly the receipts that are already slowest.
# ADR-0039 measures one extract on a CPU-only box in minutes. Off by default.
CONSISTENCY_ENABLED=false

# How many independent extractions a consistency pass makes. Three is the
# smallest number that can produce a majority; two can only agree or disagree.
CONSISTENCY_RUNS=3

# A second, larger n for the critical fields, spent ON DEMAND: the pass runs
# CONSISTENCY_RUNS, and only escalates to this when the total, date or merchant
# came back with no majority and was nulled. A receipt whose critical fields
# all resolve still costs CONSISTENCY_RUNS.
#
# 0 disables escalation entirely. Set it to 5 to enable. Any value <=
# CONSISTENCY_RUNS is inert.
CONSISTENCY_CRITICAL_RUNS=0

# **A JSON array. Not a comma-separated list.** This field is a
# `tuple[str, ...]` on a pydantic `BaseSettings`, so the value is parsed as
# JSON. Measured rather than assumed: `totals.total,receipt.date` raises
# `SettingsError: error parsing value for field "consistency_critical_fields"`
# and the service refuses to start. Loud is the right failure, but the syntax
# catches people out.
#
# The default is the §12 triple -- the same three fields `score.confidence`
# penalises for being missing and the eval harness scores as `critical_correct`.
# Paths use `extract.paths` grammar (`totals.total`, `line_items[2].qty`).
CONSISTENCY_CRITICAL_FIELDS=["totals.total","receipt.date","merchant.name"]


# ---------------------------------------------------------------------------
# Infra -- required (receipts.asgi refuses to boot without DATABASE_URL and
# REDIS_URL)
# ---------------------------------------------------------------------------

# The database. SQLite is the simplest local choice: a file next to the repo,
# no server to run. Production uses Postgres (ADR-0004); point at it with
#   DATABASE_URL=postgresql+psycopg://receipts:receipts@localhost:5432/receipts
# and install the driver: pip install -e ".[postgres]".
DATABASE_URL=sqlite:///receipts.db

# The queue broker. POST /upload enqueues through it and the worker drains it,
# so it is not optional. Run Redis on the host (`redis-server`, default 6379).
REDIS_URL=redis://localhost:6379/0

# Where STORAGE_BACKEND=local writes uploaded blobs (the worker reads them
# back). Relative to the working directory. Default is var/blobs.
STORAGE_BACKEND=local
STORAGE_ROOT=var/blobs


# ---------------------------------------------------------------------------
# Service -- required to serve the review API
# ---------------------------------------------------------------------------

# Signs the review session cookie and the expiring image URLs. No default:
# create_app refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Plain HTTP on loopback for local dev. The Secure flag would make the cookie
# unusable, so allow it explicitly. A real deployment terminates TLS upstream
# and sets NEITHER of these.
SESSION_COOKIE_SECURE=false
ALLOW_INSECURE_SESSION_COOKIE=true

# Whether this process serves the built review UI. Left false, the API runs
# without it (open http://localhost:8000/app/ only after `npm run build` in
# frontend/ and SERVE_SPA=true). True with no build refuses to start.
SERVE_SPA=false
